class RelationalChecks(unittest.TestCase):
    def test_original_relations_and_preserved_fibers(self):
        for a, b in PAIRS:
            self.assertEqual(layer_sum(a, b), REFERENCE)
            self.assertEqual(layer_cross(a), layer_cross(b))
            self.assertEqual(strand(a) + strand(b), UNIT)
        self.assertEqual(tuple(layer_cross(a) for a in range(REFERENCE)),
                         (0, 1, 4, 0, 7, 7, 0, 4, 1))
        self.assertNotEqual(fiber(1), fiber(8))
        self.assertEqual(fiber(1).crossing, fiber(8).crossing)
        self.assertNotEqual(fiber(0).period, fiber(9).period)
        self.assertEqual(fiber(0).crossing, fiber(9).crossing)
        self.assertEqual(dr(sum(LOOP)), PAIRS[-1][0])

    def test_scale_readings_and_domain_boundary(self):
        for n in (0, 1, 3, 10, 100):
            s = scale_seed(n)
            self.assertEqual(s.normalized_big_pair(), (s.closed, s.rest))
            self.assertGreater(s.rest, ZERO)
            self.assertEqual(residue_fraction(s.big), 1)
            self.assertEqual(residue_fraction(s.rest), 1)
            self.assertEqual(residue_fraction(s.closed), 0)
            self.assertEqual(residue_fraction(s.big_nines), 0)
        with self.assertRaises(ValueError):
            residue_fraction(strand(1))
        self.assertNotEqual(layer_cross(BASE + 1), layer_cross(1))

    def test_exact_roundtrip_on_unstructured_states(self):
        rng = Random(20261013)
        for trial in range(24):
            q = tuple(Fraction(rng.randrange(-9, 10), rng.randrange(1, 10))
                      for _ in ADDRESSES)
            p = tuple(Fraction(rng.randrange(-9, 10), rng.randrange(1, 10))
                      for _ in ADDRESSES)
            original = State(q, p, scale_seed(trial % 4))
            state = original
            for _ in range(8):
                state = step(state)
                validate(state)
            for _ in range(8):
                state = unstep(state)
            self.assertEqual(state, original)
            self.assertEqual(step(unstep(original)), original)

    def test_pulse_orientation_and_inverse_via_exponent(self):
        state = step(seed(2))
        self.assertEqual(pulse(state, +1), step(state))
        self.assertEqual(pulse(state, -1), unstep(state))
        self.assertEqual(pulse(pulse(state, +1), -1), state)
        self.assertEqual(pulse(pulse(state, -1), +1), state)

    def test_totals_and_complementary_fields(self):
        initial = seed()
        state = initial
        for _ in range(16):
            self.assertEqual(sum(state.q), sum(initial.q))
            self.assertEqual(sum(state.p), sum(initial.p))
            for a in ADDRESSES:
                self.assertEqual(state.q[a] + state.q[complement(a)], UNIT)
                self.assertEqual(state.p[a] + state.p[complement(a)], ZERO)
            self.assertEqual(state.scale.normalized_big_pair(),
                             (state.scale.closed, state.scale.rest))
            self.assertGreater(state.scale.rest, ZERO)
            state = step(state)

    def test_gauge_covariance_and_all_readers(self):
        state = step(seed(3))
        shifted = gauge_shift(state, Fraction(7, 3), Fraction(-11, 5))
        self.assertEqual(step(shifted),
                         gauge_shift(step(state),
                                     Fraction(7, 3), Fraction(-11, 5)))
        for reader, other in product(ADDRESSES, repeat=TWO):
            sight = view(state, reader)
            self.assertEqual(view(shifted, reader), sight)
            self.assertEqual(rereference(sight, other), view(state, other))
            self.assertEqual(evolve_view(sight), view(step(state), reader))

    def test_complement_covariance_and_direction_reversal(self):
        state = step(seed())
        self.assertEqual(step(mirror(state)), mirror(step(state)))
        h = Fraction(1, BASE)
        q_new, p_new = shear_pair(state.q, state.p, h)
        q_back, p_back = shear_pair(q_new, tuple(-v for v in p_new), h)
        self.assertEqual(q_back, state.q)
        self.assertEqual(p_back, tuple(-v for v in state.p))

    def test_real_feedback_and_reader_participation(self):
        empty = (ZERO,) * BASE
        baseline = State(empty, empty, scale_seed())
        q4 = tuple(UNIT * (a == LOOP[0]) for a in ADDRESSES)
        response4 = step(replace(baseline, q=q4))
        destination = dr(sum(LOOP))
        self.assertNotEqual(response4.p[destination], ZERO)
        self.assertNotEqual(response4.q[destination], ZERO)
        q2 = tuple(UNIT * (a == destination) for a in ADDRESSES)
        response2 = step(replace(baseline, q=q2))
        self.assertEqual(response2.p[LOOP[0]], response4.p[destination])
        self.assertNotEqual(response2.q[LOOP[0]], ZERO)
        self.assertEqual(evolve_view(view(replace(baseline, q=q2), LOOP[0])),
                         view(response2, LOOP[0]))

    def test_no_invented_bridge_or_collapse_of_loop(self):
        self.assertEqual(components(),
                         ((0, 3, 6, 9), (1, 8), (2, 4, 5, 7)))
        state = seed()
        self.assertEqual(step(state).loop, state.loop[::-1])
        self.assertEqual(step(step(state)).loop, state.loop)
        empty = (ZERO,) * BASE
        quiet = State(empty, empty, scale_seed())
        self.assertEqual(step(quiet).q, empty)
        self.assertEqual(step(quiet).p, empty)


class EmergentChecks(unittest.TestCase):
    def test_crossing_orbit_is_algebraic(self):
        # F^k(a) = a^(2^k) mod 9: Trajektorie ohne Verzweigung.
        for a in ADDRESSES:
            self.assertEqual(TRAJECTORIES[a][0], a)
            self.assertEqual(TRAJECTORIES[a][1], layer_cross(a))
            self.assertEqual(TRAJECTORIES[a][2], layer_cross(layer_cross(a)))
        # Struktur stimmt mit der klassischen Orbit-Zerlegung ueberein.
        self.assertEqual(crossing_orbit(0), CrossingOrbit((), (0,)))
        self.assertEqual(crossing_orbit(1), CrossingOrbit((), (1,)))
        self.assertEqual(crossing_orbit(2), CrossingOrbit((2,), (4, 7)))
        self.assertEqual(crossing_orbit(4), CrossingOrbit((), (4, 7)))
        self.assertEqual(crossing_orbit(5), CrossingOrbit((5,), (7, 4)))
        self.assertEqual(crossing_orbit(7), CrossingOrbit((), (7, 4)))

    def test_structural_role_weights(self):
        self.assertEqual(structural_role(crossing_orbit(0)),
                         "Grenzverlauf zur Null-Lesart")
        self.assertEqual(structural_role(crossing_orbit(1)),
                         "Grenzverlauf zur Eins-Lesart")
        self.assertEqual(structural_role(crossing_orbit(4)),
                         "Gegenlaeufige Mittelschleife")
        self.assertEqual(structural_role(crossing_orbit(5)),
                         "Gegenlaeufige Mittelschleife")

    def test_loop_phase_is_indicator_sum(self):
        self.assertEqual(loop_phase(LOOP, LOOP[0]), "erste Schleifenlesart")
        self.assertEqual(loop_phase(LOOP, LOOP[1]), "zweite Schleifenlesart")
        self.assertEqual(loop_phase(LOOP, 0), "ausserhalb des Zweizyklus")
        self.assertEqual(loop_phase(LOOP[::-1], LOOP[0]),
                         "zweite Schleifenlesart")
        self.assertEqual(loop_phase(LOOP[::-1], LOOP[1]),
                         "erste Schleifenlesart")

    def test_scope_masks_are_the_relations_themselves(self):
        sight = genomic_view(genomic_seed(), 4)
        all_ids = tuple(r.context.locus for r in read_contexts(sight))
        comp_ids = tuple(r.context.locus
                         for r in read_contexts(sight, "component"))
        hood_ids = tuple(r.context.locus
                         for r in read_contexts(sight, "neighborhood"))
        self.assertEqual(all_ids, ADDRESSES)
        self.assertEqual(comp_ids, (2, 4, 5, 7))
        self.assertEqual(hood_ids, tuple(sorted({4, *NEIGHBORS[4]})))
        outer = genomic_view(genomic_seed(), 1)
        self.assertEqual(tuple(r.context.locus
                               for r in read_contexts(outer, "component")),
                         (1, 8))
        with self.assertRaises(KeyError):
            read_contexts(sight, "remote-signals")


class DNAIntegrationChecks(unittest.TestCase):
    def test_all_contexts_preserve_original_relations(self):
        for a in ADDRESSES:
            source, context = fiber(a), translate_fiber(a)
            self.assertEqual(
                (context.locus, context.complementary_locus,
                 context.context_crossing, context.radial_shell,
                 context.strand_fraction, context.counter_strand_fraction),
                (source.address, source.opposite, source.crossing,
                 source.shell, source.period, source.opposite_period))
        self.assertTrue(translate_fiber(0).is_boundary)
        self.assertTrue(translate_fiber(REFERENCE).is_boundary)
        self.assertNotEqual(translate_fiber(0).strand_fraction,
                            translate_fiber(REFERENCE).strand_fraction)
        self.assertEqual(translate_fiber(4).base, translate_fiber(8).base)
        self.assertNotEqual(translate_fiber(4).context_crossing,
                            translate_fiber(8).context_crossing)

    def test_full_translation_commutes_in_both_directions(self):
        rng = Random(20261013)
        for n in (0, 1, 3, 10):
            for _ in range(8):
                q = tuple(Fraction(rng.randrange(-9, 10),
                                   rng.randrange(1, 10))
                          for _ in ADDRESSES)
                p = tuple(Fraction(rng.randrange(-9, 10),
                                   rng.randrange(1, 10))
                          for _ in ADDRESSES)
                source = State(q, p, scale_seed(n))
                dna = translate_state(source)
                self.assertEqual(dna.to_core(), source)
                self.assertEqual(genomic_step(dna),
                                 translate_state(step(source)))
                self.assertEqual(genomic_unstep(dna),
                                 translate_state(unstep(source)))
                self.assertEqual(genomic_unstep(genomic_step(dna)), dna)
                self.assertEqual(genomic_step(genomic_unstep(dna)), dna)

    def test_scale_backward_and_normalized_pairs(self):
        for n in (0, 1, 3, 100):
            scale = FoldingScale.from_core(scale_seed(n))
            onward = scale.pulse(+1)
            self.assertEqual(onward.pulse(-1), scale)
            self.assertEqual(scale.normalized_big_pair(),
                             (scale.integrated_fraction, scale.open_fraction))
            self.assertGreater(onward.open_fraction, ZERO)
        signed = FoldingScale.from_core(scale_seed(-1))
        self.assertLess(signed.integrated_fraction, ZERO)
        self.assertEqual(signed.pulse(+1).pulse(-1), signed)

    def test_fields_loop_and_reader_really_coevolve(self):
        dna = genomic_seed()
        following = genomic_step(dna)
        self.assertNotEqual(following.q, dna.q)
        self.assertNotEqual(following.p, dna.p)
        self.assertNotEqual(following.q[LOOP[0]], dna.q[LOOP[0]])
        self.assertEqual(following.loop, dna.loop[::-1])
        self.assertNotEqual(genomic_view(following, LOOP[0]),
                            genomic_view(dna, LOOP[0]))
        self.assertNotEqual(
            read_context(genomic_view(following, LOOP[0]),
                         LOOP[0]).loop_phase,
            read_context(genomic_view(dna, LOOP[0]),
                         LOOP[0]).loop_phase)

    def test_all_readers_evolve_and_rewind_locally(self):
        dna = genomic_step(genomic_seed())
        for reader in ADDRESSES:
            sight = genomic_view(dna, reader)
            self.assertEqual(evolve_genomic_view(sight),
                             genomic_view(genomic_step(dna), reader))
            self.assertEqual(rewind_genomic_view(sight),
                             genomic_view(genomic_unstep(dna), reader))
            self.assertEqual(rewind_genomic_view(evolve_genomic_view(sight)),
                             sight)
            self.assertEqual(sight.relative_q[reader], ZERO)
            self.assertEqual(sight.relative_p[reader], ZERO)

    def test_gauge_and_reader_changes_preserve_relational_readouts(self):
        dna = genomic_step(genomic_seed())
        shifted = genomic_gauge_shift(dna, Fraction(17, 3), Fraction(-13, 7))
        for reader, other in product(ADDRESSES, repeat=TWO):
            sight = genomic_view(dna, reader)
            self.assertEqual(genomic_view(shifted, reader), sight)
            self.assertEqual(rereference_genomic_view(sight, other),
                             genomic_view(dna, other))
            first = read_contexts(sight)
            second = read_contexts(genomic_view(dna, other))
            self.assertEqual(
                tuple((r.complement_q_difference,
                       r.complement_p_difference,
                       r.current_feedback, r.relation_load)
                      for r in first),
                tuple((r.complement_q_difference,
                       r.complement_p_difference,
                       r.current_feedback, r.relation_load)
                      for r in second))

    def test_feedback_is_a_changing_relational_readout(self):
        zero_fields = (ZERO,) * BASE
        source = DNAState(zero_fields, zero_fields,
                          FoldingScale.from_core(scale_seed()), LOOP)
        excited = replace(source,
                          q=tuple(UNIT * (a == LOOP[0])
                                  for a in ADDRESSES))
        before = read_context(genomic_view(excited, LOOP[0]),
                              dr(sum(LOOP)))
        after_state = genomic_step(excited)
        after = read_context(genomic_view(after_state, LOOP[0]),
                             dr(sum(LOOP)))
        self.assertTrue(before.is_return_address)
        self.assertNotEqual(before.current_feedback, ZERO)
        self.assertNotEqual(after_state.p[dr(sum(LOOP))], ZERO)
        self.assertNotEqual(after.current_feedback, before.current_feedback)
        self.assertGreater(before.relation_load, ZERO)

    def test_biological_labels_do_not_become_hidden_drivers(self):
        renamed = replace(DEFAULT_DNA_SCHEMA,
                          name="Gleiche Basisrelation, alternative Hypothese",
                          candidate_roles=("offene Zuordnung",) * BASE)
        other_bases = {"A": "C", "T": "G", "C": "A", "G": "T", None: None}
        alternative = replace(renamed,
                              bases=tuple(other_bases[b]
                                          for b in renamed.bases))
        original = genomic_seed()
        changed = genomic_seed(schema=alternative)
        self.assertEqual(genomic_step(original).to_core(),
                         genomic_step(changed).to_core())
        self.assertNotEqual(translate_fiber(4, original.schema).base,
                            translate_fiber(4, changed.schema).base)
        self.assertEqual(translate_fiber(4, original.schema).structural_role,
                         translate_fiber(4, changed.schema).structural_role)

    def test_sequence_annotation_and_reverse_complement(self):
        annotation = SequenceAnnotation("ATCG", (4, 1, 2, 3))
        annotation.validate_with(DEFAULT_DNA_SCHEMA)
        counterpart = annotation.reverse_complement()
        self.assertEqual(counterpart.sequence, "CGAT")
        self.assertEqual(counterpart.loci, (6, 7, 8, 5))
        counterpart.validate_with(DEFAULT_DNA_SCHEMA)
        self.assertEqual(counterpart.reverse_complement(), annotation)
        source = genomic_seed(annotation=annotation)
        state = source
        for _ in range(12):
            state = genomic_step(state)
            self.assertEqual(state.annotation, annotation)
            self.assertEqual(genomic_view(state, 4).annotation, annotation)
        for _ in range(12):
            state = genomic_unstep(state)
        self.assertEqual(state, source)

    def test_rejects_silent_domain_changes(self):
        state = genomic_seed()
        for reader in (-1, BASE, True, Fraction(4)):
            with self.assertRaises(ValueError):
                genomic_view(state, reader)
        wrong = list(DEFAULT_DNA_SCHEMA.bases)
        wrong[1] = "C"
        with self.assertRaises(ValueError):
            replace(DEFAULT_DNA_SCHEMA, bases=tuple(wrong))
        with self.assertRaises(ValueError):
            replace(state.scale, scale_factor=10.0)
        with self.assertRaises(ValueError):
            replace(state, q=(ZERO,) * (BASE - 1))
        with self.assertRaises(ValueError):
            replace(state, annotation=SequenceAnnotation("A", (1,)))


def verify_dna():
    suite = unittest.TestSuite((
        unittest.defaultTestLoader.loadTestsFromTestCase(RelationalChecks),
        unittest.defaultTestLoader.loadTestsFromTestCase(EmergentChecks),
        unittest.defaultTestLoader.loadTestsFromTestCase(DNAIntegrationChecks),
    ))
    return unittest.TextTestRunner(verbosity=2).run(suite)


