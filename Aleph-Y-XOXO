
from __future__ import annotations

"""
ALEPH-Y-XOXO — fully relational reference kernel

Interpretive contract
---------------------
* A cell is an address of one relational field, not a container.
* SOMA and PSYCHE are conjugate readings present at every position.
* B is not a coordinate, observer or perception channel. B is the locally
  available, non-dissociated capacity of every address to carry its X-relation
  and to receive the formerly excluded component back.
* Y is the handed pulse already implied by R and X. It is never called as a
  motor of the material dynamics.
* O is not stored in a cell. It is read from the completed circulation of all
  local relations (holonomy).
* Gravity, NOW, nervous regulation and fractal curvature are projections and
  readouts of that circulation. They are not extra matter.
* Every material mutation is a rotation. One step is computed from one
  immutable snapshot and can be unfolded from its recorded angles to
  floating-point precision.
"""

from dataclasses import asdict, dataclass, fields
from enum import IntEnum
from hashlib import sha256
import json
import math
from typing import Iterable, Mapping, Sequence


N = 40
N_CAMPS = 4
TAU = 2.0 * math.pi
EPSILON = "ε_T"


class StructuralError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise StructuralError(message)


def wrap_index(k: int) -> int:
    return k % N


def wrap_scale(scale: int, scales: int) -> int:
    return scale % scales


def wrap_angle(angle: float) -> float:
    return math.atan2(math.sin(angle), math.cos(angle))


def rotate_pair(a: float, b: float, angle: float) -> tuple[float, float]:
    c = math.cos(angle)
    s = math.sin(angle)
    return a * c - b * s, a * s + b * c


def circular_mean(angles: Iterable[float]) -> float:
    angles = tuple(angles)
    return math.atan2(
        math.fsum(math.sin(angle) for angle in angles),
        math.fsum(math.cos(angle) for angle in angles),
    )


def stable_digest(data: object) -> str:
    raw = json.dumps(
        data,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
        allow_nan=False,
    ).encode("utf-8")
    return sha256(raw).hexdigest()


class Sheet(IntEnum):
    PSYCHE = -1
    SOMA = +1


@dataclass(frozen=True, order=True)
class Address:
    scale: int
    k: int
    sheet: Sheet

    def normalized(self, scales: int) -> "Address":
        return Address(
            wrap_scale(self.scale, scales),
            wrap_index(self.k),
            Sheet(self.sheet),
        )


def R(address: Address) -> Address:
    return Address(address.scale, wrap_index(address.k + 1), address.sheet)


def R_inv(address: Address) -> Address:
    return Address(address.scale, wrap_index(address.k - 1), address.sheet)


def X(address: Address, axis_k: int) -> Address:
    """Exterior name for an X-reading through any chosen gauge axis."""
    return Address(
        address.scale,
        wrap_index(2 * axis_k - address.k),
        Sheet(-int(address.sheet)),
    )


def local_X(address: Address) -> Address:
    """
    Immanent B-frame of this address.

    No global B is selected. Every position can carry the crossing.
    local_X(a) is the other reading at the same relational position.
    """
    return Address(address.scale, address.k, Sheet(-int(address.sheet)))


def Y(address: Address) -> Address:
    """
    Exterior compression of the handed pulse: Y_sigma = R**sigma.

    LivingLaw never invokes Y to cause a transition. Its living modulation
    is inferred from antisymmetric relational torque.
    """
    return Address(
        address.scale,
        wrap_index(address.k + int(address.sheet)),
        address.sheet,
    )


@dataclass(frozen=True)
class RelationalState:
    # Six material pairs. Their joint squared norm is the material invariant.
    d_form: float
    t_surplus: float
    he_core: float
    alpha_land: float
    shadow_n: float
    real_light_gamma: float
    xi_shol: float
    log_seam_kappa: float
    aiin: float
    edy: float
    void_center: float
    entropy: float

    # Gauge orientation, not a thirteenth material substance.
    phase: float

    def content_vector(self) -> tuple[float, ...]:
        return (
            self.d_form,
            self.t_surplus,
            self.he_core,
            self.alpha_land,
            self.shadow_n,
            self.real_light_gamma,
            self.xi_shol,
            self.log_seam_kappa,
            self.aiin,
            self.edy,
            self.void_center,
            self.entropy,
        )

    def content_norm2(self) -> float:
        return math.fsum(value * value for value in self.content_vector())

    def to_data(self) -> dict[str, float]:
        return asdict(self)

    @staticmethod
    def from_data(data: Mapping[str, float]) -> "RelationalState":
        return RelationalState(
            **{
                item.name: float(data[item.name])
                for item in fields(RelationalState)
            }
        )


@dataclass(frozen=True)
class Cell:
    address: Address
    state: RelationalState

    def to_data(self) -> dict[str, object]:
        return {
            "address": {
                "scale": self.address.scale,
                "k": self.address.k,
                "sheet": int(self.address.sheet),
            },
            "state": self.state.to_data(),
        }

    @staticmethod
    def from_data(data: Mapping[str, object]) -> "Cell":
        address_data = data["address"]
        state_data = data["state"]

        require(isinstance(address_data, Mapping), "invalid address")
        require(isinstance(state_data, Mapping), "invalid state")

        return Cell(
            Address(
                int(address_data["scale"]),
                int(address_data["k"]),
                Sheet(int(address_data["sheet"])),
            ),
            RelationalState.from_data(state_data),
        )


